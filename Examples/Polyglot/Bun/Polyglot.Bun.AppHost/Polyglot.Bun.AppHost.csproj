<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>a3d0c2f0-2f7b-4e3a-9d2e-2f0c6a8b5d4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AddBunApp requires Aspire.Hosting.JavaScript 13.4+ (this repo's central pin is 13.1.0,
      used by the other JavaScript examples). VersionOverride keeps the rest of the workshop
      on 13.1.0 while this example alone picks up the newer, Bun-capable release.
    -->
    <PackageReference Include="Aspire.Hosting.JavaScript" VersionOverride="13.4.6" />
  </ItemGroup>

</Project>
